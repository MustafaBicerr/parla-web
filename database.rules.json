        ".read": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'consultant' || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')",
        ".indexOn": [
          "company_id",
          "status",
          "end_date"
        ],
        ".write": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin')",
        "$contractId": {
          ".read": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'consultant' || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')",
          ".write": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin')"
        }
      },
      "projects": {
        ".read": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'consultant' || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')",
        ".indexOn": [
          "company_id",
          "status",
          "project_code"
        ],
        ".write": "auth != null && ((root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin') || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')",
        "$projectId": {
          ".read": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'consultant' || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')",
          ".write": "auth != null && ((root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin') || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')"
        }
      },
      "departments": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin'",
        "$departmentId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin'"
        }
      },
      "sap_modules": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin'",
        "$moduleId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin'"
        }
      },
      "support_types": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin'",
        "$typeId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin'"
        }
      },
      "activities": {
        ".read": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'consultant' || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')",
        ".indexOn": [
          "created_at",
          "entity_type",
          "user_uid"
        ],
        "$actId": {
          ".read": "auth != null && (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'consultant' || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager')",
          ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').exists() && root.child('v2/users').child(auth.uid).child('is_active').val() !== false && !data.exists() && newData.exists()"
        }
      },
      "counters": {
        ".read": "auth != null",
        "$type": {
          "$code": {
            "$yymm": {
              ".write": "auth != null && root.child('v2/users').child(auth.uid).child('role').exists() && root.child('v2/users').child(auth.uid).child('is_active').val() !== false",
              ".validate": "newData.isNumber() && newData.val() >= 1"
            }
          }
        }
      },
      "notifications": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && (auth.uid === $uid || (root.child('v2/users').child(auth.uid).child('role').val() === 'super_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'service_admin' || root.child('v2/users').child(auth.uid).child('role').val() === 'consultant' || root.child('v2/users').child(auth.uid).child('role').val() === 'project_manager'))"
        }
      }
    }
  }
}
